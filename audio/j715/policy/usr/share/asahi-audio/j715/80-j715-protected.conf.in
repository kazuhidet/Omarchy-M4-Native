monitor.alsa.rules = [
  {
    "matches": [
      {
        "api.alsa.path": "hw:AppleJ715,0",
        "media.class": "Audio/Sink"
      }
    ],
    "actions": {
      "update-props": {
        "node.name": "alsa_output.j715.RawSpeakers",
        "node.description": "J715 raw speakers (do not use)",
        "node.nick": "RawSpeakers",
        "audio.rate": 48000,
        "audio.allowed-rates": [
          48000
        ],
        "audio.format": "S32LE",
        "audio.channels": 6,
        "audio.position": [
          "AUX0",
          "AUX1",
          "AUX2",
          "AUX3",
          "AUX4",
          "AUX5"
        ],
        "channelmix.lock-volumes": true,
        "channelmix.max-volume": 1.0,
        "api.alsa.soft-mixer": true
      }
    }
  }
]
node.software-dsp.rules = [
  {
    "matches": [
      {
        "api.alsa.path": "hw:AppleJ715,0",
        "media.class": "Audio/Sink"
      }
    ],
    "actions": {
      "create-filter": {
        "filter-path": "/usr/share/asahi-audio/j715/graph.json",
        "hide-parent": true
      }
    }
  }
]
wireplumber.profiles = {
  "main": {
    "node.software-dsp": "required"
  }
}
wireplumber.components.rules = [
 { matches = [ { provides = "node.software-dsp" } ]
   actions = { merge = { before = [ support.standard-event-source ] } } }
]
