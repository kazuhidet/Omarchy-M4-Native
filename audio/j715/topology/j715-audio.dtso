// J715 (15-inch M4 Air) six-amplifier speaker topology, built into
// j713_audio_dt3.ko with M4_BOARD=j715. From the J715 ADT, /arm-io/i2c3
// (all sn012776): 0x38 left woofer 1, 0x3b right woofer 1, 0x39 left tweeter,
// 0x3c right tweeter, 0x3a left woofer 2, 0x3d right woofer 2. Amplifiers 0-3
// keep the J713 order; 4 and 5 are the J715's second woofers. Reset is gpio0
// pin 15, as on the J713.
/dts-v1/;
/plugin/;
/ {
    /* Exact saved pinctrl phandle0x3f must be rechecked before native apply. */
    fragment@0 {
        target-path = "/soc/i2s@393600000";
        __overlay__ {
            apple,speaker-group = <&speaker_group>;
        };
    };
    fragment@1 {
        target-path = "/";
        __overlay__ {
            speaker_group: speaker-group {
                compatible = "apple,j715-speaker-group";
                reset-gpios = <0x3f 15 0>;
            };
            sound {
                compatible = "apple,j715-audio";
                model = "Apple J715";
                apple,speaker-group = <&speaker_group>;
                apple,codecs = <&amp0 &amp1 &amp2 &amp3 &amp4 &amp5>;
            };
        };
    };
    fragment@2 {
        target-path = "/soc/i2c@3ad01c000";
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            amp0: amplifier@38 {   /* left woofer 1 */
                compatible = "ti,sn012776";
                reg = <0x38>;
                #sound-dai-cells = <0>;
                apple,speaker-group = <&speaker_group>;
            };
            amp1: amplifier@3b {   /* right woofer 1 */
                compatible = "ti,sn012776";
                reg = <0x3b>;
                #sound-dai-cells = <0>;
                apple,speaker-group = <&speaker_group>;
            };
            amp2: amplifier@39 {   /* left tweeter */
                compatible = "ti,sn012776";
                reg = <0x39>;
                #sound-dai-cells = <0>;
                apple,speaker-group = <&speaker_group>;
            };
            amp3: amplifier@3c {   /* right tweeter */
                compatible = "ti,sn012776";
                reg = <0x3c>;
                #sound-dai-cells = <0>;
                apple,speaker-group = <&speaker_group>;
            };
            amp4: amplifier@3a {   /* J715 only: left woofer 2 */
                compatible = "ti,sn012776";
                reg = <0x3a>;
                #sound-dai-cells = <0>;
                apple,speaker-group = <&speaker_group>;
            };
            amp5: amplifier@3d {   /* J715 only: right woofer 2 */
                compatible = "ti,sn012776";
                reg = <0x3d>;
                #sound-dai-cells = <0>;
                apple,speaker-group = <&speaker_group>;
            };
        };
    };
};
